# ==============================================================================
# Alpha Prod Orbit: Environment Configuration Template
# Streamlined Strictly for Cinema & Video Streaming Infrastructure
# Copy to .env and configure your values.
# ==============================================================================

# ------------------------------------------------------------------------------
# Core Storage & Mount Configuration
# ------------------------------------------------------------------------------
# Oracle Linux 9 (OCI) example paths:
#   SERVER_DATA_DIR=/opt/alpha-orbit/data
#   ALPHA_MOUNT_POINT=/mnt/alpha
SERVER_DATA_DIR=/run/media/banana/Alpha/project/alpha/alpha-prod-orbit/data
ALPHA_MOUNT_POINT=/run/media/banana/Alpha

# ------------------------------------------------------------------------------
# Container Images (GHCR / Multi-Arch Overrides)
# ------------------------------------------------------------------------------
# Dashboard image on GitHub Container Registry
GHCR_DASHBOARD_IMAGE=ghcr.io/<your-github-username>/alpha-prod-dashboard:latest
# FlareSolverr image (supports multi-arch / OCI ARM64)
FLARESOLVERR_IMAGE=ghcr.io/flaresolverr/flaresolverr:latest

# ------------------------------------------------------------------------------
# Tailscale Configuration
# ------------------------------------------------------------------------------
TS_HOSTNAME=alpha-prod-orbit

# Browser authentication is used by default on first launch.
# The startup script will display the Tailscale approval URL in the terminal / logs.
# Alternatively, if you prefer headless non-interactive authentication,
# uncomment and provide a pre-authenticated reusable/ephemeral key from:
# https://login.tailscale.com/admin/settings/keys
TS_AUTHKEY=
TS_EXTRA_ARGS=
TS_USERSPACE=true

# ==============================================================================
# SANDBOX DOWNLOAD STACK CONFIGURATION
# ==============================================================================

# ------------------------------------------------------------------------------
# VPN Switcher API Security Token
# Controls VPN profile switching via local API (127.0.0.1:8001)
# Generate: python3 -c 'import secrets; print(secrets.token_urlsafe(48))'
# ------------------------------------------------------------------------------
SWITCHER_API_KEY=

# ------------------------------------------------------------------------------
# Active Gluetun VPN Profile
# Options: custom | cloudflare | protonvpn | windscribe | mullvad | airvpn
# ------------------------------------------------------------------------------
GLUETUN_VPN_PROVIDER=custom
GLUETUN_VPN_TYPE=wireguard

# --- Cloudflare WARP (default, free, zero credentials needed) ---
WARP_PRIVATE_KEY=
WARP_ADDRESS=172.16.0.2/32
WARP_PUBLIC_KEY=bmXOC+F1FxEMF9dyiK2H5/1SUtzH0JuVo51h2wPfgyo=
WARP_ENDPOINT_IP=162.159.192.5
WARP_ENDPOINT_PORT=2408

# --- ProtonVPN Free (https://protonvpn.com -> WireGuard config) ---
PROTON_USER=
PROTON_PASS=

# --- Windscribe Free (https://windscribe.com -> control panel) ---
WINDSCRIBE_USER=
WINDSCRIBE_PASS=

# --- Mullvad VPN Paid (https://mullvad.net -> WireGuard configuration) ---
MULLVAD_PRIVATE_KEY=
MULLVAD_ADDRESSES=

# --- AirVPN Paid (https://airvpn.org/generator/) ---
AIRVPN_KEY=

# ------------------------------------------------------------------------------
# Media Discovery & Streaming APIs
# ------------------------------------------------------------------------------
# TMDb v3 API Key (used by dashboard server-side TMDb proxy; keeps key out of client JS)
TMDB_API_KEY=

# Seerr API Key (http://localhost:5055 -> Settings -> General -> API Key)
SEERR_API_KEY=
SEERR_URL=http://127.0.0.1:5055

# Jellyfin API Key (http://localhost:8096 -> Dashboard -> API Keys -> New Key)
JELLYFIN_API_KEY=
JELLYFIN_URL=http://127.0.0.1:8096

# ------------------------------------------------------------------------------
# Ingestion Managers (qBittorrent, Radarr, Sonarr, Prowlarr)
# ------------------------------------------------------------------------------
# qBittorrent WebUI credentials (configure after first launch at http://localhost:8081)
QBIT_USER=admin
QBIT_PASS=

# Radarr API Key (http://localhost:7878 -> Settings -> General -> API Key)
RADARR_API_KEY=

# Sonarr API Key (http://localhost:8989 -> Settings -> General -> API Key)
SONARR_API_KEY=

# Prowlarr API Key (http://localhost:9696 -> Settings -> General -> API Key)
PROWLARR_API_KEY=

# ------------------------------------------------------------------------------
# Push Notifications (ntfy)
# ------------------------------------------------------------------------------
NTFY_TOPIC=alpha-prod-alerts
NTFY_URL=https://ntfy.sh
NTFY_TOKEN=

# ------------------------------------------------------------------------------
# Sandbox Lifecycle & Quality Tuning
# ------------------------------------------------------------------------------
# Cooldown window before sandbox shuts down after all downloads complete (minutes)
SANDBOX_COOLDOWN_MINUTES=30
STALL_THRESHOLD_SECONDS=900
STALL_THRESHOLD_MINUTES=15
NO_RESULT_HOURS=6

SEARCH_TIMEOUT_SECONDS=30
DISCOVERY_TIMEOUT_SECONDS=45
DISCOVERY_TTL_MINUTES=30
MAX_SEARCH_RETRIES=3
RETRY_BACKOFF_BASE_MINUTES=5
