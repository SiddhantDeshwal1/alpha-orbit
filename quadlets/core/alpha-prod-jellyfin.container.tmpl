[Unit]
Description=Alpha Prod Orbit - Jellyfin Cinema Server
After=alpha-prod-tailscale.service
BindsTo=alpha-prod-tailscale.service
PartOf=alpha-prod-tailscale.service

[Container]
ContainerName=alpha-prod-jellyfin
Image=docker.io/jellyfin/jellyfin:latest
Network=alpha-prod-tailscale.container
User=0
Group=0
Environment=JELLYFIN_PublishedServerUrl=http://__TS_HOSTNAME__:8096
Volume=__APP_DIR__/jellyfin:/config:Z
Volume=/var/tmp/jellyfin-cache:/cache:Z
Volume=/var/tmp/jellyfin-cache/transcodes:/cache/transcodes:Z
Volume=__DATA_DIR__/jellyfin/media/Entertainment:/media/entertainment:Z
Volume=__DATA_DIR__/seerr/media/download/completed:/media/downloads:ro,Z
Volume=__APP_DIR__/jellyfin/index.html:/jellyfin/jellyfin-web/index.html:ro,Z
Volume=__APP_DIR__/jellyfin/custom-details-hero.js:/jellyfin/jellyfin-web/custom-details-hero.js:ro,Z
Volume=__APP_DIR__/jellyfin/custom-hover-preview.js:/jellyfin/jellyfin-web/custom-hover-preview.js:ro,Z
Volume=__APP_DIR__/jellyfin/custom-discover-request.js:/jellyfin/jellyfin-web/custom-discover-request.js:ro,Z
Volume=__DATA_DIR__/jellyfin/data/JellyBridge:/data/JellyBridge:Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
MemoryHigh=1536M
MemoryMax=2048M
CPUQuota=350%

[Install]
WantedBy=default.target
