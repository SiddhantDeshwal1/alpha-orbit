[Unit]
Description=Alpha Prod Orbit - Seerr Media Discovery & Requests
After=alpha-prod-tailscale.service alpha-prod-jellyfin.service
BindsTo=alpha-prod-tailscale.service
PartOf=alpha-prod-tailscale.service

[Container]
ContainerName=alpha-prod-seerr
Image=ghcr.io/seerr-team/seerr:latest
Network=alpha-prod-tailscale.container
Environment=LOG_LEVEL=info
Environment=PORT=5055
Environment=TZ=Asia/Kolkata
Volume=__APP_DIR__/seerr:/app/config:Z

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
MemoryHigh=384M
MemoryMax=512M

[Install]
WantedBy=default.target
