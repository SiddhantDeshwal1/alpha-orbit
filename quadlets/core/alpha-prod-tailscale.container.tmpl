[Unit]
Description=Alpha Prod Orbit - Tailscale Mesh VPN Sidecar

[Container]
ContainerName=alpha-prod-tailscale
Image=docker.io/tailscale/tailscale:latest
HostName=__TS_HOSTNAME__
EnvironmentFile=__APP_DIR__/.env
Environment=TS_STATE_DIR=/var/lib/tailscale
Environment=TS_HOSTNAME=__TS_HOSTNAME__
Volume=__DATA_DIR__/tailscale:/var/lib/tailscale:Z
AddDevice=/dev/net/tun
AddCapability=NET_ADMIN
AddCapability=NET_RAW
DNS=1.1.1.1
DNS=1.0.0.1
DNS=8.8.8.8
Network=alpha_prod_default.network
IP=10.89.0.2
NetworkAlias=alpha-prod-tailscale
NetworkAlias=alpha-prod-jellyfin
NetworkAlias=alpha-prod-seerr
NetworkAlias=alpha-prod-dashboard
PublishPort=127.0.0.1:3000:3000
PublishPort=127.0.0.1:8096:8096
PublishPort=127.0.0.1:5055:5055

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
MemoryHigh=192M
MemoryMax=256M

[Install]
WantedBy=default.target
