[Unit]
Description=Alpha Prod Orbit - Gluetun VPN Gateway with Hardware Kill-Switch
After=alpha-prod-tailscale.service

[Container]
ContainerName=alpha-prod-gluetun
Image=docker.io/qmcgaw/gluetun:latest
Network=alpha_prod_sandbox_net.network
Network=alpha_prod_default.network
NetworkAlias=alpha-prod-gluetun
NetworkAlias=alpha-prod-qbittorrent
NetworkAlias=alpha-prod-radarr
NetworkAlias=alpha-prod-sonarr
NetworkAlias=alpha-prod-prowlarr
AddHost=alpha-prod-flaresolverr:172.31.0.19
AddHost=alpha-prod-tailscale:10.89.0.2
AddCapability=NET_ADMIN
AddDevice=/dev/net/tun
NoNewPrivileges=true
EnvironmentFile=__APP_DIR__/.env
EnvironmentFile=%h/.config/containers/systemd/alpha-orbit-mapped.env
Environment=DNS_UPSTREAM_RESOLVER_TYPE=plain
Environment=DNS_UPSTREAM_PLAIN_ADDRESSES=1.1.1.1:53,1.0.0.1:53
Environment=DNS_KEEP_NAMESERVER=on
Environment=DOT=off
Environment=HEALTH_TARGET_ADDRESS=cloudflare.com:443
Environment=HEALTH_VPN_DURATION_INITIAL=20s
Environment=HEALTH_VPN_DURATION_ADDITION=30s
Environment=HEALTH_SUCCESS_WAIT_DURATION=10s
Environment=FIREWALL=on
Environment=FIREWALL_OUTBOUND_SUBNETS=172.31.0.0/24,10.89.0.0/24
Environment=FIREWALL_INPUT_PORTS=7878,8989,9696,8080,8000,8888
Environment=HTTPPROXY=on
Environment=VPN_INTERFACE=tun0
Environment='HTTP_CONTROL_SERVER_AUTH_DEFAULT_ROLE={"auth":"none"}'
PublishPort=127.0.0.1:8000:8000
PublishPort=127.0.0.1:8888:8888
PublishPort=127.0.0.1:8081:8080
PublishPort=127.0.0.1:7878:7878
PublishPort=127.0.0.1:8989:8989
PublishPort=127.0.0.1:9696:9696
Volume=__APP_DIR__/sandbox/gluetun:/gluetun:Z
HealthCmd=wget -qO- http://127.0.0.1:9999
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=15s

[Service]
Restart=always
RestartSec=5
TimeoutStartSec=300
MemoryMax=128M

[Install]
WantedBy=default.target
