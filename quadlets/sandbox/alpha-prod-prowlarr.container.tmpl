[Unit]
Description=Alpha Prod Prowlarr (Central Indexer & Tracker Aggregator)
After=alpha-prod-gluetun.service
BindsTo=alpha-prod-gluetun.service

[Container]
Image=lscr.io/linuxserver/prowlarr:latest
ContainerName=alpha-prod-prowlarr
Network=alpha-prod-gluetun.container

Environment=PUID=1000
Environment=PGID=1000
Environment=TZ=Asia/Kolkata

Volume=__APP_DIR__/sandbox/prowlarr:/config:Z

Tmpfs=/tmp:rw,noexec,nosuid,size=128M
NoNewPrivileges=true
SecurityLabelDisable=false

HealthCmd=curl -s -f http://127.0.0.1:9696/ping >/dev/null || exit 1
HealthInterval=15s
HealthTimeout=5s
HealthRetries=5
HealthStartPeriod=30s

[Service]
Restart=on-failure
TimeoutStartSec=300
MemoryMax=256M
