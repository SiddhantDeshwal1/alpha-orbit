[Unit]
Description=Alpha Prod ClamAV (Antivirus Daemon Sidecar)

[Container]
Image=docker.io/clamav/clamav:latest
ContainerName=alpha-prod-clamav
Network=alpha_prod_default.network
Network=alpha_prod_sandbox_net.network

Environment=CLAMAV_NO_FRESHCLAMD=false
Environment=CLAMAV_NO_CLAMD=false
Environment=CLAMAV_NO_MILTERD=true

Volume=__DATA_DIR__/sandbox/clamav/db:/var/lib/clamav:Z
Volume=__DATA_DIR__/seerr/media/download/staging:/scan/staging:ro,z

Tmpfs=/tmp:rw,noexec,nosuid,size=256M
NoNewPrivileges=true
SecurityLabelDisable=false

HealthCmd=clamdcheck.sh
HealthInterval=60s
HealthTimeout=30s
HealthRetries=3
HealthStartPeriod=120s

[Service]
Restart=on-failure
TimeoutStartSec=300
MemoryMax=1600M
MemoryHigh=1200M
CPUQuota=150%
